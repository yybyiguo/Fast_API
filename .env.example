# 本地开发配置模板：复制为 backend/.env 后按本机情况修改
# Copy this file to backend/.env and adjust for your machine.

app_env=dev

db_host=127.0.0.1
db_port=3306
db_user=root
db_password=change-me
db_name=toutiao

# Windows 上 6379 可能被 Hyper-V 保留；如果 Redis 起不来，换成 16379
redis_host=127.0.0.1
redis_port=6379
redis_db=0
redis_decode_responses=true

# RSS 管理白名单（逗号分隔的用户名），留空表示所有登录用户
rss_admin_users=admin
rsshub_base=http://127.0.0.1:1200
rss_private_hosts=127.0.0.1,localhost
