# 复制为 .env.docker 供 docker compose 使用
# 生产环境务必替换数据库密码，并删掉 rss_private_hosts 里的内网地址

app_env=prod
# 容器里只写 stdout；需要文件日志改成 1，并给容器挂载 /app/logs
LOG_TO_FILE=0

db_host=mysql
db_port=3306
db_user=root
db_password=change-me
db_name=toutiao

redis_host=redis
redis_port=6379
redis_db=0
redis_decode_responses=true

rss_admin_users=admin
rsshub_base=http://rsshub:1200
# 允许订阅的内网主机；本地 RSSHub 用，生产环境应清空
rss_private_hosts=127.0.0.1,localhost,rsshub

# 抖音路由需要登录 cookie；不抓抖音可留空
# 从浏览器登录 douyin.com 后，F12 -> Network -> 任意请求 -> Request Headers -> Cookie
DOUYIN_COOKIE=
